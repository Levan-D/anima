{
  "name": "music-player",
  "productName": "Music Player",
  "version": "0.1.0",
  "private": true,
  "description": "A personal foobar2000-style music player for Windows",
  "author": "Levan",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --user-data-dir=.dev/dev-user-data",
    "dev:watch": "electron-vite dev --watch -- --user-data-dir=.dev/dev-user-data",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write --end-of-line auto .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "fetch:binaries": "node scripts/fetch-binaries.mjs",
    "dist": "npm run build && electron-builder --win"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "music-metadata": "^12.3.2",
    "onnxruntime-node": "1.31.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.65.0",
    "motion": "^14.8.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
